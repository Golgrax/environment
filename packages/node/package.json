{
  "name": "@octovel/environment",
  "version": "0.0.23",
  "description": "A lightweight and cross-platform Node.js library to safely interact with the system, user, and process environment through a unified, type-safe API.",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "scripts": {
    "build": "node ./scripts/building/build.js",
    "build:bash": "bash ./scripts/building/build.bash",
    "build:powershell": "pwsh ./scripts/building/build.ps1",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/octovel/environment.git",
    "directory": "."
  },
  "keywords": [
    "package",
    "node",
    "typescript",
    "environment"
  ],
  "author": "Sébastien GARCIA <sebastien.garcia@mail.com> (https://github.com/Striatp)",
  "contributors": [
    {
      "name": "Sébastien GARCIA",
      "email": "sebastien.garcia@mail.com",
      "url": "https://github.com/Striatp"
    }
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "engine-strict": true,
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/octovel/environment/issues"
  },
  "homepage": "https://github.com/octovel/environment#readme",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/Striatp"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    }
  },
  "files": [
    "build",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@10.19.0",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^24.7.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
